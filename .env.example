# ==============================================================
# Django Auth Fortress — Environment Configuration
# ==============================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# ==============================================================

# ─── Django Core ──────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_fortress
DB_NAME=auth_fortress
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2

# ─── JWT Settings ─────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=your-jwt-signing-key

# ─── OAuth2 Providers ────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── Email (SMTP) ────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@authfortress.com

# ─── Security ────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ─── Rate Limiting ───────────────────────────────────────────
LOGIN_RATE_LIMIT=5/m
API_RATE_LIMIT=100/h

# ─── Frontend URL (for email links) ─────────────────────────
FRONTEND_URL=http://localhost:3000
